[Unit]
Description=Velocity Minecraft Proxy
After=network-online.target docker.service
Wants=network-online.target docker.service

[Service]
Type=simple
User=svalbard
WorkingDirectory=/home/svalbard/projects/active/velocity
ExecStart=/home/svalbard/projects/active/velocity/start.sh
Restart=on-failure
RestartSec=5
StandardOutput=append:/home/svalbard/projects/active/velocity/velocity.log
StandardError=append:/home/svalbard/projects/active/velocity/velocity.log

[Install]
WantedBy=multi-user.target
