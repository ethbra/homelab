# Local-only symlinks to live files outside the repo (ATM10 and CasaOS config).
/config/

# Keys and decrypted secrets never enter git.
*.agekey
age.key
keys.txt
*.dec
*.dec.*
*.decrypted*
.env
.env.*

# OpenTofu: state can contain secrets. Only tofu/terraform.tfstate is
# committed, and tofu refuses to write it unencrypted (tofu/versions.tf).
.terraform/
*.tfstate
*.tfstate.*
!/tofu/terraform.tfstate
*.tfplan
crash.log

# Tooling
.ansible/
*.retry
__pycache__/
