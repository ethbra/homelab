# Local-only symlinks to live files outside the repo (ATM10 and CasaOS config).
/config/

# Keys and decrypted secrets never enter git.
*.agekey
age.key
keys.txt
*.dec
*.dec.*
*.decrypted*
.env
.env.*

# OpenTofu: state can contain secrets; it is stored encrypted outside git.
.terraform/
*.tfstate
*.tfstate.*
crash.log

# Tooling
.ansible/
*.retry
__pycache__/
